# Development only; change all credentials for any shared deployment.
POSTGRES_USER=onboard
POSTGRES_PASSWORD=local-only
POSTGRES_DB=onboard
MINIO_ROOT_USER=onboard-local
MINIO_ROOT_PASSWORD=local-storage-only
DATABASE_URL=postgresql+psycopg://onboard:local-only@localhost:5432/onboard
AI_PROVIDER=mock
# Optional live extraction (OpenAI-compatible API). Leave empty to use only the SIMULATED mock.
# Enabling it sends document segments to that third-party API; staff must acknowledge this per job.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
APP_ORIGIN=http://localhost:3000
# Set true with HTTPS in shared deployments.
COOKIE_SECURE=false
S3_ACCESS_KEY=onboard-local
S3_SECRET_KEY=local-storage-only
SMTP_HOST=localhost
SMTP_PORT=1025
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=onboard-private
# Customer review links and email (M3). Mailpit receives mail locally. For a real SMTP relay set
# SMTP_HOST/SMTP_PORT (and SMTP_USERNAME/SMTP_PASSWORD/SMTP_STARTTLS); links use APP_ORIGIN unless
# PUBLIC_BASE_URL is set. Use an https origin in any shared deployment.
SMTP_FROM=Implementation team <onboard@example.invalid>
